--library_type=microlib --strict --scatter "MainControlBoard\MainControlBoard.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "MainControlBoard.map" -o MainControlBoard\MainControlBoard.axf
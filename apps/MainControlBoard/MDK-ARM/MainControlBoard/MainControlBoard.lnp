--cpu Cortex-M3
"maincontrolboard\startup_stm32l151xc.o"
"maincontrolboard\main.o"
"maincontrolboard\gpio.o"
"maincontrolboard\i2c.o"
"maincontrolboard\spi.o"
"maincontrolboard\tim.o"
"maincontrolboard\usart.o"
"maincontrolboard\stm32l1xx_it.o"
"maincontrolboard\stm32l1xx_hal_msp.o"
"maincontrolboard\stm32l1xx_hal_i2c.o"
"maincontrolboard\stm32l1xx_hal.o"
"maincontrolboard\stm32l1xx_hal_rcc.o"
"maincontrolboard\stm32l1xx_hal_rcc_ex.o"
"maincontrolboard\stm32l1xx_hal_flash.o"
"maincontrolboard\stm32l1xx_hal_flash_ex.o"
"maincontrolboard\stm32l1xx_hal_flash_ramfunc.o"
"maincontrolboard\stm32l1xx_hal_gpio.o"
"maincontrolboard\stm32l1xx_hal_dma.o"
"maincontrolboard\stm32l1xx_hal_pwr.o"
"maincontrolboard\stm32l1xx_hal_pwr_ex.o"
"maincontrolboard\stm32l1xx_hal_cortex.o"
"maincontrolboard\stm32l1xx_hal_exti.o"
